#!/bin/sh

set -e

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing required packages"
PKG_LIB="su-exec goreman openssh samba minidlna transmission-daemon transmission-cli bash curl" 
PKG_DEV=""
docker-install -r -u ${PKG_LIB} ${PKG_DEV}
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing filebrowser"
curl -fsSL https://raw.githubusercontent.com/filebrowser/get/master/get.sh | bash
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Uninstalling unnecessary packages"
docker-install -d -c ${PKG_DEV}
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Setting basic configurations"
#common
mkdir -p /data

#samba
mkdir -p /var/log/samba

mkdir -p /conf.d /conf.d/samba
touch /conf.d/samba/smb.conf

#minidlna
mkdir -p /var/run/minidlna
chown minidlna:minidlna /var/run/minidlna
chmod 775 /var/run/minidlna
mkdir -p /var/cache/minidlna
chown minidlna:minidlna /var/cache/minidlna

mkdir -p /conf.d /conf.d/minidlna
touch /conf.d/minidlna/minidlna.conf

#transmission
mkdir -p /conf.d /conf.d/transmission-daemon
touch /conf.d/transmission-daemon/settings.json

#filebrowser
mkdir -p /conf.d /conf.d/filebrowser 
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

